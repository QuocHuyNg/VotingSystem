# ============================================================
# FRONTEND .env — Vite Environment Variables
# ============================================================

# URL backend API
VITE_API_URL=http://localhost:5000/api

# Sepolia Etherscan base URL
VITE_ETHERSCAN_TX_URL=https://sepolia.etherscan.io/tx
VITE_ETHERSCAN_ADDRESS_URL=https://sepolia.etherscan.io/address

# Contract address — sẽ được cập nhật sau khi deploy
# Có thể để trống, frontend sẽ đọc từ src/contracts/Voting.json
VITE_CONTRACT_ADDRESS=
